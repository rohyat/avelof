{
  "name": "avelof",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:cloudflare": "wrangler pages dev dist --port 8791",
    "build": "tsc -b && tsc -p tsconfig.functions.json && vite build",
    "deploy": "wrangler pages deploy dist --project-name avelof --branch main",
    "test": "node --test functions/api/enquiries.test.mjs",
    "test:reviews-ui": "node --test tests/review-carousel.test.mjs",
    "test:trip-chat": "node --test tests/trip-chat.test.mjs",
    "setup:access": "node scripts/setup-enquiry-access.mjs",
    "setup:admin-password": "node scripts/set-admin-password.mjs",
    "setup:push-notifications": "node scripts/setup-push-notifications.mjs",
    "sync:images": "node scripts/sync-catalog-images.mjs",
    "import:reviews": "node scripts/import-owner-reviews.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "playwright": "^1.65.0",
    "tailwindcss": "^4.3.4",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.160.0"
  }
}
